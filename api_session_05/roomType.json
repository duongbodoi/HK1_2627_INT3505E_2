{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/room-type.schema.json",
  "title": "RoomType",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "hotel_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Giá mỗi đêm"
    },
    "capacity": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["id", "hotel_id", "name", "price"],
  "additionalProperties": false
}