{
  "title": "Booking",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "customer_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "checked_in", "completed", "cancelled"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/booking_item" }
    },
    "total": {
      "type": "number",
      "minimum": 0,
      "readOnly": true,
      "description": "Tổng giá của các item, do server tính"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  },
  "required": ["id", "customer_id", "status", "items", "total"],
  "additionalProperties": false,
  "$defs": {
    "booking_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "readOnly": true
        },
        "room_id": {
          "type": "string",
          "format": "uuid"
        },
        "check_in": {
          "type": "string",
          "format": "date"
        },
        "check_out": {
          "type": "string",
          "format": "date",
          "description": "Phải sau check_in, schema không kiểm tra được nên cần validate ở tầng ứng dụng"
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "description": "Giá tại thời điểm đặt, lấy từ RoomType.price"
        }
      },
      "required": ["id", "room_id", "check_in", "check_out", "price"],
      "additionalProperties": false
    }
  }
}